variable "gcp_project_id" {
  description = "The Google Cloud Platform project ID"
  type        = string
  default     = "{{ .GCPProjectID }}"
}

variable "gcp_region" {
  description = "The default region in GCP (Always Free Tier)"
  type        = string
  default     = "{{ .Region }}"
}
{{ if .IncludeComputeEngine }}
variable "gcp_zone" {
  description = "The zone in GCP for Compute Engine (Always Free Tier: us-central1, us-east1, us-west1)"
  type        = string
  default     = "{{ .Region }}-b"
}
{{ end }}
