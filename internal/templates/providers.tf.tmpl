terraform {
  required_version = ">= 1.5.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
{{- if .IncludeCloudflare }}
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.0"
    }
{{- end }}
  }
}

provider "google" {
  project = var.gcp_project_id
  region  = var.gcp_region
}

{{ if .IncludeCloudflare }}
provider "cloudflare" {
  api_token = var.cloudflare_api_token
}
{{ end }}