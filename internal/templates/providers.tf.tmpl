terraform {
  required_version = ">= 1.5.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
{{- if .IncludeCloudFunctions }}
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.0"
    }
{{- end }}
  }
}

provider "google" {
  project = var.gcp_project_id
  region  = var.gcp_region
}