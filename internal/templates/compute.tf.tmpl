# ------------------------------------------------------------------------------
# Compute Layer (Cloud Run Microservices & Compute Engine)
# ------------------------------------------------------------------------------

{{ range .Services }}
# ------------------------------------------------------------------------------
# Cloud Run Service: {{ .Name }}
# ------------------------------------------------------------------------------

# Dedicated Service Account for {{ .Name }} (Principle of Least Privilege / Zero Trust)
resource "google_service_account" "{{ .Name }}_sa" {
  account_id   = "{{ $.ProjectName }}-{{ .Name }}-sa"
  display_name = "Execution Service Account for {{ .Name }}"
  description  = "Least privilege identity for Cloud Run service {{ .Name }}"
}

{{ if $.IncludeFirestore }}
# Minimum privilege for Firestore (Datastore User instead of primitive roles)
resource "google_project_iam_member" "{{ .Name }}_firestore_user" {
  project = var.gcp_project_id
  role    = "roles/datastore.user"
  member  = "serviceAccount:${google_service_account.{{ .Name }}_sa.email}"
}
{{ end }}

{{ if $.IncludeStorage }}
# Minimum privilege for Storage (Object User limited to application bucket)
resource "google_storage_bucket_iam_member" "{{ .Name }}_storage_user" {
  bucket = google_storage_bucket.app_storage.name
  role   = "roles/storage.objectUser"
  member = "serviceAccount:${google_service_account.{{ .Name }}_sa.email}"
}
{{ end }}

{{ if $.IncludeSecrets }}
# Minimum privilege to read application secret
resource "google_secret_manager_secret_iam_member" "{{ .Name }}_secret_accessor" {
  secret_id = google_secret_manager_secret.app_secret.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.{{ .Name }}_sa.email}"
}
{{ end }}

resource "google_cloud_run_v2_service" "{{ .Name }}" {
  name     = "{{ $.ProjectName }}-{{ .Name }}"
  location = var.gcp_region
{{ if .IsPublic }}
  ingress = "INGRESS_TRAFFIC_ALL"
{{ else }}
  # Attack surface reduction: internal traffic and Cloud Load Balancing only
  ingress = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER"
{{ end }}

  template {
    # Explicit assignment of dedicated Service Account (avoids default SA with roles/editor)
    service_account = google_service_account.{{ .Name }}_sa.email

    containers {
      image = "gcr.io/${var.gcp_project_id}/{{ .Name }}:latest"

      resources {
        limits = {
          memory = "{{ .Memory }}"
          cpu    = "{{ .CPU }}"
        }
      }
    }

    # $0/month guarantee: Scale to zero when idle
    scaling {
      min_instance_count = 0
      max_instance_count = 5
    }
  }
}

{{ if .IsPublic }}
# Public Access for {{ .Name }} (Internet-facing API)
resource "google_cloud_run_v2_service_iam_member" "{{ .Name }}_public" {
  name     = google_cloud_run_v2_service.{{ .Name }}.name
  location = google_cloud_run_v2_service.{{ .Name }}.location
  role     = "roles/run.invoker"
  member   = "allUsers"
}
{{ end }}

{{ if .EnablePubSub }}
# ------------------------------------------------------------------------------
# Pub/Sub Integration for {{ .Name }}
# ------------------------------------------------------------------------------
resource "google_pubsub_topic" "{{ .Name }}_topic" {
  name = "{{ $.ProjectName }}-{{ .Name }}-events"
}

resource "google_service_account" "{{ .Name }}_pubsub_invoker" {
  account_id   = "pubsub-invoker-{{ .Name }}"
  display_name = "PubSub Invoker for {{ .Name }}"
}

resource "google_cloud_run_v2_service_iam_member" "{{ .Name }}_pubsub_perm" {
  name     = google_cloud_run_v2_service.{{ .Name }}.name
  location = google_cloud_run_v2_service.{{ .Name }}.location
  role     = "roles/run.invoker"
  member   = "serviceAccount:${google_service_account.{{ .Name }}_pubsub_invoker.email}"
}

resource "google_pubsub_subscription" "{{ .Name }}_sub" {
  name  = "{{ $.ProjectName }}-{{ .Name }}-sub"
  topic = google_pubsub_topic.{{ .Name }}_topic.name

  push_config {
    push_endpoint = "${google_cloud_run_v2_service.{{ .Name }}.uri}/events"

    oidc_token {
      service_account_email = google_service_account.{{ .Name }}_pubsub_invoker.email
    }
  }
}
{{ end }}
{{ end }}

{{ if .IncludeComputeEngine }}
# ------------------------------------------------------------------------------
# Compute Engine: Free Tier e2-micro VM Instance
# ------------------------------------------------------------------------------

# Dedicated Service Account for Compute Engine (Least Privilege / Zero-Trust)
resource "google_service_account" "vm_sa" {
  account_id   = "{{ .ProjectName }}-vm-sa"
  display_name = "Execution Service Account for {{ .ProjectName }} VM"
  description  = "Least privilege identity for Compute Engine VM"
}

{{ if .IncludeFirestore }}
# Minimum privilege for Firestore (Datastore User)
resource "google_project_iam_member" "vm_firestore_user" {
  project = var.gcp_project_id
  role    = "roles/datastore.user"
  member  = "serviceAccount:${google_service_account.vm_sa.email}"
}
{{ end }}

{{ if .IncludeStorage }}
# Minimum privilege for Storage (Object User)
resource "google_storage_bucket_iam_member" "vm_storage_user" {
  bucket = google_storage_bucket.app_storage.name
  role   = "roles/storage.objectUser"
  member = "serviceAccount:${google_service_account.vm_sa.email}"
}
{{ end }}

{{ if .IncludeSecrets }}
# Minimum privilege to read application secret
resource "google_secret_manager_secret_iam_member" "vm_secret_accessor" {
  secret_id = google_secret_manager_secret.app_secret.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.vm_sa.email}"
}
{{ end }}

resource "google_compute_instance" "vm_instance" {
  name         = "{{ .ProjectName }}-vm"
  machine_type = "e2-micro"
  zone         = var.gcp_zone

  tags = ["http-server", "https-server"]

  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 30
      type  = "pd-standard"
    }
  }

  network_interface {
    network = "default"
{{ if .VMPublicIP }}

    access_config {
      # Ephemeral public IP - Covered by Always Free limits for single e2-micro
    }
{{ end }}
  }

  service_account {
    email  = google_service_account.vm_sa.email
    scopes = ["cloud-platform"]
  }

  shielded_instance_config {
    enable_secure_boot          = true
    enable_vtpm                 = true
    enable_integrity_monitoring = true
  }

  metadata = {
    enable-oslogin = "TRUE"
  }
{{ if .VMIdleShutdown }}

  metadata_startup_script = <<-EOT
    #!/bin/bash
    # Automated idle shutdown watchdog (GCP Free Tier $0/mo guarantee)
    cat << 'EOF' > /usr/local/bin/idle-shutdown.sh
    #!/bin/bash
    THRESHOLD=1.0
    IDLE_COUNT=0
    while true; do
      CPU_LOAD=$(awk '{print $1}' /proc/loadavg)
      IS_IDLE=$(awk -v cpu="$CPU_LOAD" -v thresh="$THRESHOLD" 'BEGIN {print (cpu < thresh) ? 1 : 0}')
      if [ "$IS_IDLE" -eq 1 ]; then
        IDLE_COUNT=$((IDLE_COUNT + 1))
        if [ "$IDLE_COUNT" -ge 30 ]; then
          logger -t idle-shutdown "System idle for 30 minutes (CPU load $CPU_LOAD). Powering off."
          sudo poweroff
        fi
      else
        IDLE_COUNT=0
      fi
      sleep 60
    done
    EOF
    chmod +x /usr/local/bin/idle-shutdown.sh
    nohup /usr/local/bin/idle-shutdown.sh >/dev/null 2>&1 &
  EOT
{{ end }}
}
{{ end }}

{{ if .IncludeCloudFunctions }}
# ------------------------------------------------------------------------------
# Cloud Functions (2nd Gen) Layer (Scale-to-zero serverless compute)
# ------------------------------------------------------------------------------

# Dedicated Service Account for Cloud Function (Least Privilege / Zero-Trust)
resource "google_service_account" "function_sa" {
  account_id   = "{{ .ProjectName }}-fn-sa"
  display_name = "Execution Service Account for {{ .ProjectName }} Cloud Function"
  description  = "Least privilege identity for Cloud Function"
}

resource "google_storage_bucket" "function_source" {
  name                        = "{{ .ProjectName }}-fn-source-${var.gcp_project_id}"
  location                    = var.gcp_region
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"

  lifecycle_rule {
    action {
      type = "Delete"
    }
    condition {
      age = 7 # Automatically purge source zip packages after 7 days to preserve free storage
    }
  }
}

data "archive_file" "function_placeholder" {
  type        = "zip"
  output_path = "${path.module}/function-placeholder.zip"

  source {
    content  = "exports.handler = (req, res) => { res.status(200).send('OK'); };"
    filename = "index.js"
  }
}

resource "google_storage_bucket_object" "function_zip" {
  name   = "function-source-${data.archive_file.function_placeholder.output_md5}.zip"
  bucket = google_storage_bucket.function_source.name
  source = data.archive_file.function_placeholder.output_path
}

resource "google_cloudfunctions2_function" "app_function" {
  name        = "{{ .ProjectName }}-function"
  location    = var.gcp_region
  description = "Free Tier 2nd Gen Cloud Function ($0/mo with scale to zero)"

  build_config {
    runtime     = "nodejs20"
    entry_point = "handler"

    source {
      storage_source {
        bucket = google_storage_bucket.function_source.name
        object = google_storage_bucket_object.function_zip.name
      }
    }
  }

  service_config {
    max_instance_count = 5
    min_instance_count = 0 # Scale to zero when idle ($0 guarantee)
    available_memory   = "256M"
    available_cpu      = "1"
    timeout_seconds    = 60

    service_account_email = google_service_account.function_sa.email
  }
}
{{ end }}